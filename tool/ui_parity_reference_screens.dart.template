// Runs only inside an isolated BusyMark checkout. Uses its ordinary application
// and source widgets; storage/native facilities are explicit test fixtures.
import 'dart:async';
import 'dart:io';
import 'dart:ui' as ui;
import 'package:flutter/material.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:busymark/src/app/busymark_app.dart';
import 'package:busymark/src/app/app_settings.dart';
import 'package:busymark/src/app/app_router.dart';
import 'package:busymark/src/app/system_accent.dart';
import 'package:busymark/src/app/startup_path.dart';
import 'package:busymark/src/platform/linux_header_bar_service.dart';
import 'package:busymark/src/platform/gtk_window_preferences_service.dart';
import 'package:busymark/src/platform/gtk_animation_settings_service.dart';
import 'package:busymark/src/workspace/workspace_controller.dart';
import 'package:busymark/src/workspace/session_persistence.dart';
import 'package:busymark/src/workspace/recovery_persistence.dart';
import 'package:busymark/src/local_history/local_history_store.dart';
import 'package:busymark/src/local_history/local_history_controller.dart';
import 'package:busymark/src/search/search_session.dart';
import 'ui_reference_gallery_test.dart' as fonts;

class _Settings implements LocalSettingsStore {
  Map<String, Object?> value = AppSettings.defaults().copyWith(
    autoSave: false,
    documentViewMode: DocumentViewModePreference.source,
    reopenPreviousWorkspaceOnStartup: false,
    automaticSpelling: false,
  ).toJson();
  @override
  Future<Map<String, Object?>> load() async => value;
  @override
  Future<void> save(Map<String, Object?> json) async { value = json; }
}
class _HeaderBridge extends LinuxHeaderBarService {
  _HeaderBridge() : super(channel: const MethodChannel('test.busymark/headerbar'));
  @override bool get isAvailable => false;
  @override bool get usesNativeHeaderBar => false;
  @override Stream<HeaderBarAction> get actions => const Stream.empty();
}
void main() {
  // The component harness owns exactly the same real-font loading function.
  fonts.registerRealFonts();
  for (final brightness in Brightness.values) {
    testWidgets('reference ordinary screens ${brightness.name}', (tester) async {
      final previousPlatform = debugDefaultTargetPlatformOverride;
      debugDefaultTargetPlatformOverride = TargetPlatform.linux;
      final messenger = tester.binding.defaultBinaryMessenger;
      messenger.setMockMethodCallHandler(SystemChannels.platform, (call) async =>
        call.method == 'Clipboard.hasStrings' ? <String,Object>{'value': false} : null);
      addTearDown(() => messenger.setMockMethodCallHandler(SystemChannels.platform, null));
      for (final name in ['yaru_window', 'yaru_window/events']) {
        messenger.setMockMethodCallHandler(MethodChannel(name), (call) async =>
          call.method == 'state' ? <String,Object>{'active': true, 'visible': true,
            'closable': true, 'maximized': false, 'fullscreen': false} : null);
      }
      messenger.setMockMethodCallHandler(const MethodChannel('busymark/native_menus'),
        (_) async => throw MissingPluginException());
      tester.view..physicalSize = const Size(1280,800)..devicePixelRatio = 1;
      tester.platformDispatcher.platformBrightnessTestValue = brightness;
      final oldShadows = debugDisableShadows; debugDisableShadows = false;
      final root = (await tester.runAsync(() => Directory.systemTemp.createTemp('reference-screens-')))!;
      final file = File('${root.path}/Orders.md');
      await tester.runAsync(() => file.writeAsString('# Customer orders\n\nSelect the customer, inspect their orders, and review the total.\n\n- Ada Lovelace\n- Grace Hopper\n'));
      final container = ProviderContainer(overrides: [
        localSettingsStoreProvider.overrideWithValue(_Settings()),
        linuxHeaderBarServiceProvider.overrideWithValue(_HeaderBridge()),
        systemAccentColorProvider.overrideWith((_) => Stream.value(const Color(0xff3584e4))),
        initialSystemAccentColorProvider.overrideWithValue(const Color(0xff3584e4)),
        gtkAnimationsEnabledProvider.overrideWith((_) => Stream.value(false)),
        gtkWindowPreferencesProvider.overrideWith((_) => Stream.value(GtkWindowPreferences.defaults())),
        localHistoryStoreProvider.overrideWithValue(MemoryLocalHistoryStore()),
        documentSessionStoreProvider.overrideWithValue(MemoryDocumentSessionStore()),
        documentRecoveryStoreProvider.overrideWithValue(MemoryDocumentRecoveryStore()),
        startupPathProvider.overrideWithValue(null),
      ]);
      final boundary = GlobalKey();
      await tester.pumpWidget(UncontrolledProviderScope(container: container,
        child: RepaintBoundary(key: boundary, child: const BusyMarkApp())));
      Future<void> capture(String name) async {
        await tester.runAsync(() => Future<void>.delayed(const Duration(milliseconds: 100)));
        await tester.pumpAndSettle(); expect(tester.takeException(), isNull);
        await tester.runAsync(() async {
          final output = Directory('${Platform.environment['BUSYDATA_REFERENCE_SCREEN_OUTPUT']}/${brightness.name}')..createSync(recursive:true);
          final render = boundary.currentContext!.findRenderObject()! as RenderRepaintBoundary;
          final image = await render.toImage(); final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
          await File('${output.path}/$name.png').writeAsBytes(bytes!.buffer.asUint8List()); image.dispose();
        });
      }
      addTearDown(() async {
        await tester.pumpWidget(const SizedBox());
        container.read(appRouterProvider).dispose(); container.dispose();
        debugDisableShadows=oldShadows; tester.view.reset();
        tester.platformDispatcher.clearPlatformBrightnessTestValue();
        tester.platformDispatcher.clearTextScaleFactorTestValue();
        tester.platformDispatcher.clearAccessibilityFeaturesTestValue();
        await tester.runAsync(() => root.delete(recursive:true));
      });
      await capture('welcome');
      await tester.runAsync(() => container.read(workspaceControllerProvider.notifier).openPath(file.path));
      final router = container.read(appRouterProvider); router.go('/workspace');
      await capture('workspace');
      container.read(searchSessionProvider.notifier).open(category: SearchCategory.actions);
      await capture('search-actions'); container.read(searchSessionProvider.notifier).close();
      router.go('/settings?returnTo=workspace'); await capture('settings-appearance');
      router.go('/settings?returnTo=workspace&page=keyboardShortcuts'); await capture('settings-shortcuts');
      for(final scale in [1.5,2.0]) {
        tester.view.physicalSize=const Size(760,720); tester.platformDispatcher.textScaleFactorTestValue=scale;
        router.go('/'); await capture('compact-welcome-${(scale*100).round()}');
        router.go('/workspace'); await tester.pumpAndSettle();
        container.read(searchSessionProvider.notifier).open(category: SearchCategory.actions);
        await capture('compact-search-${(scale*100).round()}'); container.read(searchSessionProvider.notifier).close();
      }
      tester.view.physicalSize=const Size(1280,800);
      tester.platformDispatcher.textScaleFactorTestValue=1.5;
      for(final locale in ['de','ar']) {
        await tester.runAsync(() => container.read(appSettingsControllerProvider.notifier).setLocaleTag(locale));
        router.go('/'); await capture('welcome-$locale-150');
        router.go('/settings?returnTo=workspace'); await capture('settings-$locale-150');
      }
      tester.platformDispatcher.accessibilityFeaturesTestValue=const FakeAccessibilityFeatures(highContrast:true, disableAnimations:true);
      router.go('/'); await capture('welcome-ar-high-contrast-150');
      debugDisableShadows = oldShadows;
      debugDefaultTargetPlatformOverride = previousPlatform;
    });
  }
}
